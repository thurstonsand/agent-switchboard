{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": { "includes": ["**", "!docs/wayfinding", "!dist", "!test/e2e/artifacts", "!test/perf/results"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 140 },
	"markdown": { "parser": { "frontmatter": true } },
	"linter": { "rules": { "preset": "recommended" } },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"overrides": [
		{
			"includes": [
				"packages/cli/src/deck/**",
				"!packages/cli/src/deck/worker.ts",
				"!packages/cli/src/deck/searcher.ts",
				"!packages/cli/src/deck/deck.ts",
				"!packages/cli/src/deck/placeholder.ts"
			],
			"plugins": ["./packages/cli/src/deck/main-thread.grit"]
		}
	]
}
