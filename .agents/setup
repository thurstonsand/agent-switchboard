#!/usr/bin/env bash
# Prepares an Amp orb to build, test, and run swb, and to run pi by hand.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo"

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export MISE_YES=1

# pi downloads fd on its first run when the system has none, and Codex warns without bubblewrap.
# grim screenshots the orb Desktop, for evidence that lives outside the terminal grid, like the Deck's title.
install_packages() {
  dpkg -s fd-find bubblewrap grim libevent-dev libncurses-dev bison >/dev/null 2>&1 && return
  sudo apt-get update -qq
  # libevent, ncurses, and bison: mise builds tmux 3.8 from source.
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq fd-find bubblewrap grim libevent-dev libncurses-dev bison
}

install_mise() {
  command -v mise >/dev/null || curl -fsSL https://mise.run | sh
  mise --version
}

persist_path() {
  local marker="# agent-switchboard: mise tools and swb"
  grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null && return
  cat >>"$HOME/.bash_profile" <<'EOF'

# agent-switchboard: mise tools and swb
case ":$PATH:" in
	*":$HOME/.local/share/mise/shims:"*) ;;
	*) export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH" ;;
esac
EOF
}

install_tools() {
  mise trust --quiet "$repo/mise.toml"
  mise install
  # Harnesses are npm globals behind node shims, and swb starts them in any project directory.
  mise use -g --quiet "node@$(mise current node)"
  # swb needs tmux 3.8 outside this repo too; the system's 3.3a is too old.
  mise use -g --quiet "asdf:mise-plugins/mise-tmux@$(mise current asdf:mise-plugins/mise-tmux)"
}

# Mirrors CI: pi itself, plus the two host packages the e2e scenarios load.
install_pi() {
  local root
  root="$(mise x -- npm root -g)"
  [ -f "$root/@earendil-works/pi-coding-agent/package.json" ] ||
    mise x -- npm install -g --no-fund --no-audit @earendil-works/pi-coding-agent
  mise reshim
}

# The other harnesses swb hosts, for spikes and e2e against fake model servers.
install_harnesses() {
  local root missing=()
  root="$(mise x -- npm root -g)"
  [ -f "$root/@anthropic-ai/claude-code/package.json" ] || missing+=(@anthropic-ai/claude-code)
  [ -f "$root/@openai/codex/package.json" ] || missing+=(@openai/codex)
  # Claude's postinstall swaps its Node wrapper for the native binary.
  [ ${#missing[@]} -eq 0 ] ||
    mise x -- npm install -g --no-fund --no-audit --allow-scripts=@anthropic-ai/claude-code "${missing[@]}"
  mise reshim
}

# The harness resolves pi-sessions and pi-wt from ~/.pi/agent/settings.json, so installing them
# there serves both e2e and a hand-run pi. The recorder comes from this checkout's dist/pi.
configure_pi() {
  for source in npm:pi-sessions npm:@thurstonsand/pi-wt "$repo/dist/pi"; do
    pi install "$source"
  done
}

# Real-model spot tests run Codex through the subscription proxy, when its key is in the env.
configure_codex() {
  [ -n "${CLI_PROXY_API_KEY:-}" ] || return 0
  local config="$HOME/.codex/config.toml"
  mkdir -p "$HOME/.codex"
  touch "$config"
  grep -Fq "[model_providers.cli_proxy]" "$config" && return
  {
    printf 'model_provider = "cli_proxy"\nmodel = "gpt-6.1-sol"\n\n'
    cat "$config"
    cat <<'EOF'

[model_providers.cli_proxy]
name = "CLIProxyAPI"
base_url = "https://aig.thurstons.house/v1"
env_key = "CLI_PROXY_API_KEY"
wire_api = "responses"
EOF
  } >"$config.tmp"
  mv "$config.tmp" "$config"
}

link_swb() {
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$repo/dist/swb" "$HOME/.local/bin/swb"
}

step "apt packages" install_packages
step "mise" install_mise
step "persist PATH" persist_path
step "mise install" install_tools
step "bun install" bun install --frozen-lockfile
step "build" mise run build
step "dist:pi" mise run dist:pi
step "link swb" link_swb
step "pi" install_pi
step "claude and codex" install_harnesses
step "codex via the subscription proxy" configure_codex
step "pi packages" configure_pi
